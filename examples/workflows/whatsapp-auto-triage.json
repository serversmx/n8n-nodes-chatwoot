      "position": [
        0,
        0
      ],
      "credentials": {
        "chatwootApi": {
          "id": "CHATWOOT_CREDENTIAL_ID",
          "name": "Chatwoot account"
        }
      },
      "webhookId": "0d13b0e2-a397-5699-abc6-f81a67eb6d70"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "be94a33b-aaa4-56db-9d7e-d5e3d90348f8",
              "leftValue": "={{ $json.content }}",
              "rightValue": "precio",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {
          "ignoreCase": true
        }
      },
      "id": "27a46fc4-1dc2-5390-bf44-1c2aa9f51585",
      "name": "Asks for prices?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendLabels",
        "conversationId": "={{ $json.conversation.id }}",
        "labels": "={{ [\"ventas\"] }}"
      },
      "id": "4faa681d-f630-51a4-bb77-93f1acf4fd68",
      "name": "Label as Sales",
      "type": "@renatoascencio/n8n-nodes-chatwoot.chatwoot",
      "typeVersion": 1,
      "position": [
        500,
        -100
      ],
      "credentials": {
        "chatwootApi": {
          "id": "CHATWOOT_CREDENTIAL_ID",
          "name": "Chatwoot account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "conversationId": "={{ $('Chatwoot Trigger').item.json.conversation.id }}",
        "content": "=¡Hola {{ $('Chatwoot Trigger').item.json.sender.name.split(' ')[0] }}! 👋 Aquí tienes nuestra lista de precios: https://acme.example/precios"
      },
      "id": "f1a4ada5-b1ac-56c0-8782-b5701ef480a2",
      "name": "Send price list",
      "type": "@renatoascencio/n8n-nodes-chatwoot.chatwoot",
      "typeVersion": 1,
      "position": [
        760,
        -100
      ],
      "credentials": {
        "chatwootApi": {
          "id": "CHATWOOT_CREDENTIAL_ID",
          "name": "Chatwoot account"
        }
      }
    }
  ],
  "connections": {
    "Chatwoot Trigger": {
